# Copy to .env and fill in values. Do NOT commit .env.

# --- Core (required) ---------------------------------------------------------

# PostgreSQL connection string for local development (matches docker-compose.yml).
# If you changed the host port mapping in docker-compose.yml, update it here too.
DATABASE_URL=postgresql://teamdesk:teamdesk@localhost:5432/teamdesk

# HTTP server settings.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Calendar dates use this IANA timezone, not the server's operating-system timezone.
# Set to the agreed company timezone, e.g. Asia/Kolkata. Defaults to UTC.
COMPANY_TIMEZONE=UTC

# --- Google OpenID Connect (required for real login) --------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application).
#
# Required in production; optional in development (login fails closed with
# 503 while unrelated endpoints such as /health keep working).
#
# Authorized redirect URI in Google Cloud Console MUST be exactly:
#   http://127.0.0.1:3000/auth/callback     (local development)
#   https://<your-host>/auth/callback       (production)
# Use 127.0.0.1 consistently; never mix localhost and 127.0.0.1.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Allowed values of the signed Google `hd` (hosted domain) ID-token claim,
# comma-separated. Validated separately from the email domain — the two are
# NOT assumed identical. Personal Gmail accounts (no hd claim) are rejected.
# Required whenever Google credentials are used; required in production.
# GOOGLE_ALLOWED_HD=transacty.ai,n23digitals.com

# The exact redirect URI registered in Google Cloud Console.
# Must be an https:// URL in production.
# OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Exact Origins (scheme + host + port) trusted for state-changing requests
# and as post-login redirect destinations, comma-separated. Must be
# https://-only in production.
# AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000

# --- Application sessions ------------------------------------------------------
# Idle expiry (minutes) and absolute expiry (hours). Activity refreshes the
# idle window but never extends the absolute expiry.
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12

# --- Google Sheets sync (OPTIONAL, not implemented yet) ------------------------
# Service account credentials for mirroring leave requests / daily updates
# to Google Sheets. Use the JSON key path or inline JSON, never commit keys.
# GOOGLE_SHEETS_CREDENTIALS_PATH=
# GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Email notifications (OPTIONAL, not implemented yet) -----------------------
# SMTP or provider API settings for manager notifications after attendance
# events. Not required until the email adapter is implemented.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MANAGER_NOTIFICATION_EMAIL=
