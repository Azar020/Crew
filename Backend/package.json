{
  "name": "transacty-teamdesk-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for a small company employee portal (Fastify + TypeScript + PostgreSQL + Drizzle)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:env": "tsx scripts/check-env.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  }
}
